APP_NAME="Ruta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En Docker/Easypanel: single,stderr para ver los errores en los logs del servicio.
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sesión, caché y cola.
#   - Un solo servidor / carga normal: déjalo en "database" (no necesita más piezas).
#   - Para alta concurrencia (cientos/miles de usuarios activos) y/o VARIAS réplicas del
#     servicio web: pon las tres en "redis", levanta un Redis y apunta REDIS_HOST a él.
#     Redis descarga la base de datos y permite compartir la sesión entre réplicas.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Con varias réplicas, los archivos subidos (firmas, logos, evidencias) deben estar en un
# almacenamiento compartido: el MISMO volumen montado en todas las réplicas, o S3
# (FILESYSTEM_DISK=s3 con las credenciales). Si cada réplica tiene su disco, se pierden entre ellas.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (para escalar). La imagen ya trae la extensión phpredis instalada.
# Para activarlo: SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis y REDIS_HOST al servidor Redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ruta: superadministrador inicial (solo se usa si aún no existe ninguno)
SUPERADMIN_NAME="Superadministrador"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# true para cargar la empresa de demostración (usuarios demo, clave Ruta2026*)
SEED_DEMO=false
# web (página) o worker (colas y tareas programadas)
CONTAINER_ROLE=web

# Días antes del vencimiento en que un documento se marca "por vencer"
DIAS_AVISO_VENCIMIENTO=30

# Onurix (SMS). Las credenciales van en cada empresa (Configuración > Integraciones). Solo cambie la URL si Onurix la cambia.
# ONURIX_URL=https://www.onurix.com/api/v1

# Notificaciones Web Push (PWA del conductor). Genere el par una sola vez con:
#   php artisan ruta:generar-vapid
# La pública va al navegador; la privada (PEM en base64) nunca sale del servidor.
VAPID_SUBJECT=mailto:servicios@solucionesapp.pro
VAPID_PUBLIC=
VAPID_PRIVATE_PEM_B64=
